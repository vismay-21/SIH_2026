# Sahakaar Seva Backend Environment Configuration
PROJECT_NAME="Sahakaar Seva API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# For local SQLite development/testing:
DATABASE_URL="sqlite:///./sahakaar_seva.db"
# For PostgreSQL / Supabase connection:
# DATABASE_URL="postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Auth Configuration (Sprint 2 Auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# CORS Configuration (comma-separated or wildcard for local dev)
CORS_ORIGINS="*"

# Pricing and Algorithm Defaults (Configurable per WAGES.md & 06_BACKEND_SPRINTS.md)
WAGE_PREMIUM_MAX_FACTOR=0.30
VISITATION_FEE=100.00
LOG_LEVEL="INFO"
